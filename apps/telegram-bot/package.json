{
  "name": "@arbridge/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "grammy": "^1.36.1" },
  "devDependencies": { "@types/node": "^22.15.0", "tsx": "^4.19.3", "typescript": "^5.8.3", "vitest": "^5.1.0" }
}
