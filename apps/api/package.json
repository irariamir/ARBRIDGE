{
  "name": "@arbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@arbridge/download-engine": "0.1.0", "@fastify/cors": "^10.0.2", "fastify": "^5.2.1", "zod": "^4.6.7" },
  "devDependencies": { "@types/node": "^22.15.0", "esbuild": "^0.28.2", "tsx": "^4.19.3", "typescript": "^5.8.3", "vitest": "^5.1.0" }
}
