# Copy to .env. Never commit real credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
API_BASE_URL=http://127.0.0.1:8787
APP_BASE_URL=http://localhost:5173
EXTENSION_ORIGIN=chrome-extension://replace-with-unpacked-extension-id

# Create a Telegram bot with BotFather and keep this token private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Generate a random secret of at least 32 characters and use the same value here and in the bot.
INTERNAL_API_SECRET=

# Optional download limits.
MAX_DOWNLOAD_BYTES=20971520
DOWNLOAD_TIMEOUT_MS=20000
